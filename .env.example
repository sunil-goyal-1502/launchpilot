# Catalyst gateway: the model must be a chat route enabled on your deployment.
LAUNCHPILOT_AI_PROVIDER=catalyst
CATALYST_AI_GATEWAY_URL=https://your-existing-gateway.example/v1
CATALYST_AI_MODEL=gpt-5.5
# Optional client-to-gateway bearer. Catalyst injects its own upstream provider key.
CATALYST_AI_GATEWAY_TOKEN=
# Optional cheaper chat model for chunk summaries; defaults to the analysis model.
CATALYST_AI_SUMMARY_MODEL=
CATALYST_AI_TIMEOUT_MS=120000
# Optional; use only if the selected models support it (e.g. low for gpt-5.5).
CATALYST_AI_REASONING_EFFORT=

# Explicit direct Compass mode (same configuration names as Athar):
# CATALYST_AI_GATEWAY_URL=https://api.core42.ai/v1
# CATALYST_AI_KEY_FILE=/absolute/path/to/platform/services/ai-gateway/.env
# An explicit CATALYST_AI_GATEWAY_TOKEN takes precedence over the local key file.

# Every generated Terraform/Bicep revision runs validation. Target profiles are
# private JSON (an array of validation-target.example.json objects from a bundle).
# No Azure subscription or Kubernetes context is selected from ambient defaults.
LAUNCHPILOT_VALIDATION_TARGETS_FILE=
LAUNCHPILOT_TERRAFORM_BIN=terraform
LAUNCHPILOT_BICEP_BIN=bicep
LAUNCHPILOT_AZ_BIN=az
LAUNCHPILOT_KUBECTL_BIN=kubectl
# Required only for a Terraform test deployment started by the worker.
# Use private persistent storage; contains Terraform state, never included in ZIPs.
LAUNCHPILOT_VALIDATION_STATE_DIR=
